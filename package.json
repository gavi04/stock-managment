{
  "name": "stockops",
  "version": "1.0.4",
  "private": true,
  "description": "StockOps desktop stock management system",
  "main": "out/main/index.js",
  "author": "Copilot",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "release": "electron-vite build && electron-builder --win --publish always",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.0",
    "csv-stringify": "^6.6.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.4.2",
    "electron": "^34.5.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "prisma": "^7.9.0",
    "vite": "^6.2.1",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.stockops.desktop",
    "productName": "StockOps",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "prisma/migrations/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gavi04",
        "repo": "stock-managment",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
